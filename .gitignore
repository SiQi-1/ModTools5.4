# ============================================================
# 本机工作区：所有本机产物只放这里，永不提交（见 workspace/README.md）
# ============================================================
/workspace/

# 迁移期兜底：旧工作区/本地目录名称（新位置都在 /workspace/ 下）
/modgen_work/
local_skills/
local_notes/
local_db_queries/
review_notes/

# ============================================================
# Python / 编辑器缓存
# ============================================================
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
*.egg-info/
node_modules/
.claude/
.vscode/
.idea/

